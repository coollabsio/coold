# Copy to .env and fill in. Never committed — root .gitignore covers it.
# Values only apply when not already exported in the shell.

# ─── Hetzner-provisioned suites (install + builder) ──────────────────────────
HETZNER_TOKEN=
HETZNER_PROJECT=my-coold-e2e
SSH_KEY=/Users/you/.ssh/id_ed25519
COOLIFY_BIN=coolify
# HETZNER_LOCATION=nbg1
# HETZNER_IMAGE=ubuntu-24.04
# HETZNER_SERVER_TYPE=cx23

# ─── Stub-dashboard suite (tests/stub.rs) ────────────────────────────────────
# Path to the prebuilt linux-x64 coolify-stub binary. Build via:
#   cd coolify-stub && bun install && (cd web && bun install)
#   BUN_TARGET=bun-linux-x64 bun scripts/build-binary.ts
# COOLIFY_STUB_BIN=./coolify-stub/dist/coolify-stub

# ─── Keep VMs + stub alive after a successful run ────────────────────────────
# Set to 1 to skip EphemeralCluster teardown (all suites) and the stub pkill
# (stub suite only). The test prints an SSH port-forward on success so you
# can poke the UI at http://localhost:3000. Tear down later with:
#   CONFIRM_SWEEP=1 cargo test -p e2e-tests --test install cleanup_leaked_hetzner -- --ignored --nocapture
# E2E_KEEP_VMS=1

# ─── Sweeper opt-in ──────────────────────────────────────────────────────────
# CONFIRM_SWEEP=1
